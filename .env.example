# SparkLens Configuration

# Root URL of your Apache Spark History Server (default: http://localhost:18080)
SPARK_HISTORY_URL="http://localhost:18080"

# Authentication mechanism (none, basic, oauth)
SPARK_AUTH_TYPE="none"

# Basic authentication username (if SPARK_AUTH_TYPE="basic")
# SPARK_USERNAME="admin"

# Basic authentication password (if SPARK_AUTH_TYPE="basic")
# SPARK_PASSWORD="password"

# OAuth bearer token (if SPARK_AUTH_TYPE="oauth")
# SPARK_ACCESS_TOKEN="your-oauth-access-token"

# Default Spark major version fallback if undetectable ('auto', '3.x', or '4.x')
SPARK_DEFAULT_VERSION="auto"

# --- MCP Server Transport Configuration ---
# Transport type (stdio or sse)
SPARK_MCP_TRANSPORT="stdio"

# Host and Port configuration (only used if SPARK_MCP_TRANSPORT="sse")
SPARK_MCP_HOST="0.0.0.0"
SPARK_MCP_PORT=8030
